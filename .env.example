# TimeTagger (self-hosted)
TIMETAGGER_URL=<your-timetagger-url>
TIMETAGGER_TOKEN=<your-timetagger-api-token>

# Strava OAuth2
STRAVA_CLIENT_ID=<your-strava-client-id>
STRAVA_CLIENT_SECRET=<your-strava-client-secret>

# ZeppBridge SQLite (health vitals only)
ZEPP_DB_PATH=<path-to-zeppbridge-zepp.db>

